{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amoshydra.github.io/keebling/editor/deck.schema.json",
  "title": "Keebling layout",
  "description": "A page is rows; a row is a line of columns; a key spans columns. A deck is a 4-column layout with every key spanning 1.",
  "type": "object",
  "required": [
    "app",
    "kind",
    "version",
    "pages"
  ],
  "properties": {
    "app": {
      "const": "keebling"
    },
    "kind": {
      "const": "layout"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "strip": {
      "type": "array",
      "description": "Ordered strip entries. Built-ins abc, sym, fn, kp; user pages as page:<id>. Built-ins may be reordered but not removed.",
      "items": {
        "type": "string",
        "pattern": "^(abc|sym|fn|kp|page:[A-Za-z0-9_-]+)$"
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "columns",
          "rows"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "name": {
            "type": "string",
            "maxLength": 24
          },
          "columns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "required": [
                "h",
                "keys"
              ],
              "properties": {
                "h": {
                  "type": "integer",
                  "minimum": 24,
                  "maximum": 120,
                  "description": "Row height in CSS pixels. The whole page scales down together if it does not fit the slot."
                },
                "gap": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "align": {
                  "enum": [
                    "stretch",
                    "center",
                    "start",
                    "end"
                  ]
                },
                "keys": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/item"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/key"
        },
        {
          "type": "object",
          "required": [
            "spacer"
          ],
          "additionalProperties": false,
          "properties": {
            "spacer": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            }
          }
        }
      ]
    },
    "key": {
      "type": "object",
      "required": [
        "label",
        "w",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "maxLength": 24
        },
        "alt": {
          "type": "string",
          "maxLength": 8
        },
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "colour": {
          "enum": [
            "",
            "blue",
            "amber",
            "red",
            "green"
          ]
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "page",
            "usage"
          ],
          "properties": {
            "kind": {
              "const": "key"
            },
            "page": {
              "type": "integer",
              "description": "HID usage page: 7 keyboard, 12 consumer"
            },
            "usage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "code": {
              "type": "string",
              "description": "KeyboardEvent.code alias, for reading"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "code"
          ],
          "properties": {
            "kind": {
              "const": "modifier"
            },
            "code": {
              "enum": [
                "ShiftLeft",
                "ControlLeft",
                "AltLeft",
                "MetaLeft"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "page"
            },
            "to": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "blocks"
          ],
          "properties": {
            "kind": {
              "const": "sequence"
            },
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          }
        }
      ]
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "action",
            "keys"
          ],
          "properties": {
            "action": {
              "const": "tap"
            },
            "keys": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "page",
                  "usage"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "action",
            "text"
          ],
          "properties": {
            "action": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "action",
            "ms"
          ],
          "properties": {
            "action": {
              "const": "delay"
            },
            "ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        {
          "type": "object",
          "required": [
            "action",
            "count",
            "blocks"
          ],
          "properties": {
            "action": {
              "const": "repeat"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          }
        }
      ]
    }
  }
}
