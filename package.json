{
  "name": "keebling-web",
  "private": true,
  "type": "module",
  "description": "Build pipeline for the device's web UI. The firmware ships dist/, never the sources.",
  "scripts": {
    "build": "node tools/build-web.mjs",
    "watch": "node tools/build-web.mjs --watch",
    "test": "node tools/build-web.mjs && node test/web/run.mjs",
    "test:web": "node test/web/run.mjs",
    "test:firmware": "test/firmware/run.sh"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "html-minifier-terser": "^7.2.0",
    "lucide-static": "^1.66.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
